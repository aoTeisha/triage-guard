{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "crm-stub (:8000)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv sync: crm-stub",
      "cwd": "${workspaceFolder}/crm-stub",
      "python": "${workspaceFolder}/crm-stub/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/crm-stub/.venv/Scripts/python.exe"
      },
      "module": "uvicorn",
      "args": ["crm.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "board (:8002)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv sync: board",
      "cwd": "${workspaceFolder}/board",
      "python": "${workspaceFolder}/board/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/board/.venv/Scripts/python.exe"
      },
      "module": "uvicorn",
      "args": ["board.api:app", "--host", "127.0.0.1", "--port", "8002"],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "sweeper (waiting-room monitor)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv sync: triage-app",
      "cwd": "${workspaceFolder}/triage-app",
      "python": "${workspaceFolder}/triage-app/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/triage-app/.venv/Scripts/python.exe"
      },
      "module": "app.monitor.sweeper",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "All services (crm-stub + board + sweeper)",
      "configurations": ["crm-stub (:8000)", "board (:8002)", "sweeper (waiting-room monitor)"],
      "preLaunchTask": "prelaunch: sync + postgres",
      "stopAll": true
    }
  ]
}
