{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "crm-stub (:8000)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/crm-stub",
      "python": "${workspaceFolder}/crm-stub/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/crm-stub/.venv/Scripts/python.exe"
      },
      "module": "uvicorn",
      "args": ["crm.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "intake-channel (:8001)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/intake-channel",
      "python": "${workspaceFolder}/intake-channel/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/intake-channel/.venv/Scripts/python.exe"
      },
      "module": "uvicorn",
      "args": ["channel.api:app", "--host", "127.0.0.1", "--port", "8001"],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "board (:8002)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/board",
      "python": "${workspaceFolder}/board/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/board/.venv/Scripts/python.exe"
      },
      "module": "uvicorn",
      "args": ["board.api:app", "--host", "127.0.0.1", "--port", "8002"],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "triage-app (demo case: clean)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/triage-app",
      "python": "${workspaceFolder}/triage-app/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/triage-app/.venv/Scripts/python.exe"
      },
      "module": "app.main",
      // swap for "missing" / "failed" / "injection" to hit the other arrows
      "args": ["clean"],
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "All services (crm-stub + intake-channel + board)",
      "configurations": ["crm-stub (:8000)", "intake-channel (:8001)", "board (:8002)"],
      "stopAll": true
    },
    {
      "name": "Everything incl. triage-app demo",
      "configurations": [
        "crm-stub (:8000)",
        "intake-channel (:8001)",
        "board (:8002)",
        "triage-app (demo case: clean)"
      ],
      "stopAll": true
    }
  ]
}
