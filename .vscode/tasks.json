{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "postgres: up",
      "type": "shell",
      "command": "docker compose -f db/docker-compose.yml up -d postgres",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "uv sync: crm-stub",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/crm-stub" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "uv sync: intake-channel",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/intake-channel" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "uv sync: board",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/board" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "uv sync: triage-app",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/triage-app" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "uv sync: all",
      "dependsOn": ["uv sync: crm-stub", "uv sync: intake-channel", "uv sync: board", "uv sync: triage-app"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "prelaunch: sync + postgres",
      "dependsOn": ["uv sync: all", "postgres: up"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
