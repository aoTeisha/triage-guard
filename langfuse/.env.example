# Local dev bootstrap only — auto-creates org/project/user/API keys on first boot.
# Keys here must match agent-example/.env's LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_ORG_ID=triage-guard
LANGFUSE_INIT_ORG_NAME=Triage Guard
LANGFUSE_INIT_PROJECT_ID=triage-guard
LANGFUSE_INIT_PROJECT_NAME=Triage Guard
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=changeme123
