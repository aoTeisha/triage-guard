# Copy to .env beside this file. Nothing here is required in mock mode.

# ---- the single LLM --------------------------------------------------------
# mock (default) runs the whole skeleton offline with no key. live calls a model.
TRIAGE_LLM=mock

# Only read when TRIAGE_LLM=live. This is the ONE place the model is named —
# the actor's persona file (app/actors/acuity_classifier.json) deliberately
# holds no model id, so there is nothing to keep in sync.
# Verified live on OpenRouter: anthropic/claude-opus-5, anthropic/claude-fable-5.1.
# (anthropic/claude-sonnet-4, which this project used to name, is gone.)
MODEL=anthropic/claude-opus-5
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- observability ---------------------------------------------------------
# Tracing is off unless both keys are set. Must match langfuse/.env.
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_SECRET_KEY=sk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_BASE_URL=http://localhost:3000
# Keys the patient hash used as the Langfuse user id. Any long random string;
# keep it secret and stable (changing it splits each patient's history).
# Unset = traces carry no patient at all.
TRIAGE_TRACE_SALT=change-me-to-a-long-random-string
# Shown as Environment in Langfuse; filter dev runs away from demo runs.
LANGFUSE_TRACING_ENVIRONMENT=dev
# App version shown on every trace; bump when prompts or the graph change.
LANGFUSE_RELEASE=triage-guard-0.1.0

# ---- services ---------------------------------------------------------------
# The CRM stub. Unreachable is a supported state: the case degrades to
# intake-only data (AF_DB) rather than failing.
CRM_BASE_URL=http://127.0.0.1:8000

# Checkpoint + timer store. Required for the human gates — interrupt() needs
# somewhere to suspend to. Postgres DSN; `docker compose up -d postgres` at
# the repo root starts it on host port 5434.
TRIAGE_CHECKPOINT_DB=postgresql://triage:triage@localhost:5434/triage
