# Copy to .env beside this file. Nothing here is required in mock mode.

# ---- the single LLM --------------------------------------------------------
# mock (default) runs the whole skeleton offline with no key. live calls a model.
TRIAGE_LLM=mock

# Only read when TRIAGE_LLM=live. This is the ONE place the model is named —
# the actor's persona file (app/actors/acuity_classifier.json) deliberately
# holds no model id, so there is nothing to keep in sync.
# Verified live on OpenRouter: anthropic/claude-opus-5, anthropic/claude-fable-5.1.
# (anthropic/claude-sonnet-4, which this project used to name, is gone.)
MODEL=anthropic/claude-opus-5
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- observability ---------------------------------------------------------
# Tracing is off unless both keys are set. Must match langfuse/.env.
LANGFUSE_PUBLIC_KEY=pk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_SECRET_KEY=sk-lf-11111111-1111-1111-1111-111111111111
LANGFUSE_BASE_URL=http://localhost:3000

# ---- services ---------------------------------------------------------------
# The CRM stub. Unreachable is a supported state: the case degrades to
# intake-only data (arrow AF·db) rather than failing.
CRM_BASE_URL=http://127.0.0.1:8000

# Checkpoint store. Required for the human gates — interrupt() needs somewhere
# to suspend to. Swap for Postgres in a real deployment.
TRIAGE_CHECKPOINT_DB=.triage_state.db
